{
  "realm": "oncology",
  "displayName": "LCHAI v2.0",
  "displayNameHtml": "<strong style=\"font-size:1.6em;letter-spacing:2px\">LCHAI V2.0</strong><br><span style=\"font-size:0.85em;color:#94a3b8;font-weight:400\">LUNG CANCER HISTOLOGIC ANALYSIS WITH AI</span>",
  "loginTheme": "lchai",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "defaultRoles": ["clinician"],
  "roles": {
    "realm": [
      { "name": "clinician", "description": "Clinical user — patients, cases, images, inference, EHR, graph, explainability" },
      { "name": "admin", "description": "Admin — full system control, parameters, ontology management, deep search, user management" },
      { "name": "auditor", "description": "Auditor — read-only audit trail" }
    ]
  },
  "users": [
    {
      "username": "clinician1",
      "enabled": true,
      "email": "clinician1@lchai.local",
      "firstName": "Dr.",
      "lastName": "Clinician",
      "credentials": [{ "type": "password", "value": "clinician1", "temporary": false }],
      "realmRoles": ["clinician"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@lchai.local",
      "firstName": "System",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "admin1", "temporary": false }],
      "realmRoles": ["admin", "clinician"]
    },
    {
      "username": "auditor1",
      "enabled": true,
      "email": "auditor1@lchai.local",
      "firstName": "Audit",
      "lastName": "User",
      "credentials": [{ "type": "password", "value": "auditor1", "temporary": false }],
      "realmRoles": ["auditor"]
    }
  ],
  "clients": [
    {
      "clientId": "oncology-api",
      "enabled": true,
      "publicClient": false,
      "secret": "oncology-secret",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "oncology-webapp",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "optionalClientScopes": ["offline_access"]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GOOGLE_CLIENT_ID:-not-configured}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET:-not-configured}",
        "defaultScope": "openid email profile",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "github",
      "providerId": "github",
      "enabled": true,
      "trustEmail": true,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "${GITHUB_CLIENT_ID:-not-configured}",
        "clientSecret": "${GITHUB_CLIENT_SECRET:-not-configured}",
        "defaultScope": "user:email",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "google-default-role",
      "identityProviderAlias": "google",
      "identityProviderMapper": "hardcoded-role-idp-mapper",
      "config": {
        "role": "clinician"
      }
    },
    {
      "name": "github-default-role",
      "identityProviderAlias": "github",
      "identityProviderMapper": "hardcoded-role-idp-mapper",
      "config": {
        "role": "clinician"
      }
    }
  ]
}
