# =============================================================================
# LCHAI v1.2 — Oncology XAI System — Environment Variables
# =============================================================================

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=oncology
POSTGRES_PASSWORD=oncology_secret
POSTGRES_DB=oncology_xai
POSTGRES_DSN=postgresql+asyncpg://oncology:oncology_secret@postgres:5432/oncology_xai
POSTGRES_DSN_SYNC=postgresql://oncology:oncology_secret@postgres:5432/oncology_xai

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3 compatible)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=oncology-xai

# Keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=oncology
KEYCLOAK_CLIENT_ID=oncology-api
JWKS_URL=http://keycloak:8080/realms/oncology/protocol/openid-connect/certs

# Fuseki (Triple Store)
FUSEKI_URL=http://fuseki:3030
FUSEKI_DATASET=oncology

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# LLM Configuration
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model Configuration
MODEL_BACKEND=mock
TRITON_URL=http://triton:8001

# Ontology paths (graph-service: grafo desde OWL real cuando Fuseki no tiene datos)
# En Docker, el volumen ontologies_data monta /data/ontologies; copiar ahí ncit.owl y mondo.owl
NCIT_OWL_PATH=/data/ontologies/ncit.owl
MONDO_OWL_PATH=/data/ontologies/mondo.owl
SO_OWL_PATH=/data/ontologies/so.owl

# Ontology Admin
ONTOLOGY_DEEP_SEARCH_ENABLED=false
ONTOLOGY_SOURCES_POLICY_ID=default_whitelist

# SHAP
SHAP_ENABLED=true

# Service URLs (internal)
CASE_SERVICE_URL=http://case-service:8001
IMAGE_SERVICE_URL=http://image-service:8002
INFERENCE_SERVICE_URL=http://inference-service:8003
EHR_SERVICE_URL=http://ehr-service:8004
GRAPH_SERVICE_URL=http://graph-service:8005
ONTOLOGY_ADMIN_SERVICE_URL=http://ontology-admin-service:8006
AUDIT_SERVICE_URL=http://audit-service:8007

# Application Settings
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=development

# Clinical Guardrails
PATTERN_THRESHOLD=0.55
MUTATION_THRESHOLD=0.60
